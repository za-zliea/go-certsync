#!/bin/sh /etc/rc.common
#
# CertSync Server init script for OpenWrt (procd)
#
# Place at: /etc/init.d/certsync-server
# Install:  chmod +x /etc/init.d/certsync-server && /etc/init.d/certsync-server enable
#

USE_PROCD=1
START=90
STOP=01

BIN=/usr/bin/certsync-server
CONF=/etc/certsync/server.yml
STORAGE=/var/lib/certsync

start_service() {
    [ -x "$BIN" ]  || { echo "binary $BIN not found"; return 1; }
    [ -f "$CONF" ] || { echo "config $CONF not found"; return 1; }

    # Ensure the certificate storage directory exists and is writable.
    mkdir -p "$STORAGE"

    procd_open_instance
    procd_set_param command "$BIN" -c "$CONF"
    # Respawn on crash: threshold 3600s, timeout 5s, max retry 5
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile=65536
    procd_close_instance
}

reload_service() {
    # Binary does not support SIGHUP; restart to pick up config changes.
    restart
}

service_triggers() {
    # Restart when the wan interface comes up (server needs outbound
    # connectivity for ACME / DNS-provider API and inbound reachability).
    procd_add_reload_interface_trigger "wan"
}

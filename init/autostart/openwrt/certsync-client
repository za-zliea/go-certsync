#!/bin/sh /etc/rc.common
#
# CertSync Client init script for OpenWrt (procd)
#
# Place at: /etc/init.d/certsync-client
# Install:  chmod +x /etc/init.d/certsync-client && /etc/init.d/certsync-client enable
#

USE_PROCD=1
START=95
STOP=01

BIN=/usr/bin/certsync-client
CONF=/etc/certsync/client.yml
STORAGE=/etc/certsync/live

start_service() {
    [ -x "$BIN" ]  || { echo "binary $BIN not found"; return 1; }
    [ -f "$CONF" ] || { echo "config $CONF not found"; return 1; }

    mkdir -p "$STORAGE"

    procd_open_instance
    procd_set_param command "$BIN" -c "$CONF"
    # Respawn on crash: threshold 3600s, timeout 5s, max retry 5
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile=65536
    procd_close_instance
}

reload_service() {
    # Binary does not support SIGHUP; restart to pick up config changes.
    restart
}

service_triggers() {
    # Reload (restart) when the wan interface comes up.
    procd_add_reload_interface_trigger "wan"
}
